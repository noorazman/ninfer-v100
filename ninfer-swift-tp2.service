[Unit]
Description=NInfer Swift 1.5 Qwen3.8-27B Serving (Multi-GPU TP=2, GPU 3 & 4)
After=network.target

[Service]
Type=simple
User=noorazman
WorkingDirectory=/home/noorazman/dsh/ninfer-v100-gguf
Environment="LD_LIBRARY_PATH=/home/noorazman/dsh/ninfer-v100-gguf/third_party/nccl_v100/lib:/usr/local/cuda/lib64"
Environment="PATH=/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/noorazman/dsh/ninfer-v100-gguf/build-phase2/bin/ninfer-serve \
    /mnt/ssd/llm_models/Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_XXS-mtp.ninfer \
    --device 3 \
    --host 0.0.0.0 --port 8000 \
    --model-id Swift-1.5-Qwen3.8-27B \
    --max-context 2048 \
    --kv-dtype int8 \
    --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
